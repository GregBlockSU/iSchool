red_file_path = file.path(folder_path, "winequality-red.csv")
white_file_path = file.path(folder_path, "winequality-white.csv")
red  <- read.csv(red_file_path)
white <- read.csv(white_file_path)
# Add categorical variable
red$type   <- "red"
white$type <- "white"
