# Step 0 - Reset R Studio
rm(list = ls()) # remove variables
graphics.off() # clear graphs
# Install packages if needed --------------------------------
pkgs <- c("ggplot2", "dplyr", "ggiraphExtra")
to_install <- pkgs[!pkgs %in% installed.packages()[, "Package"]]
